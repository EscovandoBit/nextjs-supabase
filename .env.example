# ---------------------------------------------------------------------------
# Supabase (public: inlined into the browser bundle by Next.js)
# ---------------------------------------------------------------------------
# Local: run `supabase start`, then copy the values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key from `supabase status`>"

# ---------------------------------------------------------------------------
# Write path: direct Postgres connection used by Drizzle (server only)
# ---------------------------------------------------------------------------
# DB_CONNECTION_MODE must agree with the port in DATABASE_URL. env.ts fails
# loudly on a mismatch, because that divergence otherwise only shows up in
# production under load.
#
#   transaction -> Supavisor pooler on :6543. Serverless / Vercel.
#                  Never call Drizzle's .prepare() in this mode.
#   session     -> Supavisor pooler on :5432. Long-running Node container.
#   direct      -> Postgres itself. Local Supabase CLI, migrations, pg_dump.
#
# Pool sizing rule: concurrent instances * DB_POOL_MAX <= Supavisor pool size
# (15 by default on the free plan).
#
# --- preset: local development (Supabase CLI) -------------------------------
DB_CONNECTION_MODE="direct"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DB_POOL_MAX="5"
DB_POOL_IDLE_TIMEOUT_MS="20000"
DB_POOL_CONNECT_TIMEOUT_MS="10000"

# --- preset: Vercel / serverless -------------------------------------------
# DB_CONNECTION_MODE="transaction"
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DB_POOL_MAX="3"
# DB_POOL_IDLE_TIMEOUT_MS="10000"

# --- preset: long-running Node container (Docker, Fly, Railway) -------------
# DB_CONNECTION_MODE="session"
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DB_POOL_MAX="10"
# DB_POOL_IDLE_TIMEOUT_MS="30000"

# ---------------------------------------------------------------------------
# Migrations only. Never imported by application code.
# ---------------------------------------------------------------------------
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ---------------------------------------------------------------------------
# Test fixtures only (Playwright creates and destroys users with this).
# Bypasses RLS entirely - never import it from application code.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="<service_role key from `supabase status`>"
E2E_BASE_URL="http://127.0.0.1:3000"
